# Copy to .env.local for local dev, and set the same keys in
# Vercel → Project Settings → Environment Variables for production.

# Resend API key — https://resend.com. The free tier is plenty to start.
# Without this the lead form still validates, but on Vercel it will return a
# 503 and tell the visitor to email directly, rather than silently losing them.
RESEND_API_KEY=

# Inbox that receives new tickets.
CONTACT_TO_EMAIL=studio.omora@gmail.com

# Optional. Defaults to Resend's shared onboarding@resend.dev sender, which is
# fine for testing. Swap for an address on a domain you've verified in Resend
# before going live, or replies will land badly.
CONTACT_FROM_EMAIL="Kozmoz <hello@omora.studio>"
